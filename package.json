{
  "name": "jsonschema-validator-blaze",
  "displayName": "JSON Schema Validator Blaze",
  "description": "High-performance JSON Schema validator and linter for VS Code",
  "license": "MIT",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "publisher": "Karan-Palan",
  "categories": [
    "Linters",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jsonschema.validate",
        "title": "JSON Schema: Validate"
      },
      {
        "command": "jsonschema.lint",
        "title": "JSON Schema: Lint"
      },
      {
        "command": "jsonschema.format",
        "title": "JSON Schema: Format"
      }
    ],
    "keybindings": [
      {
        "command": "jsonschema.validate",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus"
      },
      {
        "command": "jsonschema.lint",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "jsonschema.format",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "JSON Schema Extension",
      "properties": {
        "jsonSchemaExtension.cliPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the JSON Schema CLI executable"
        },
        "jsonSchemaExtension.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically validate JSON files on save"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.2.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.2",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@sourcemeta/jsonschema": "^11.5.1"
  },
  "vsce": {
    "exclude": [
      "test/**",
      "src/**",
      "out/test/**",
      "out/**/*.map",
      "**/*.ts",
      "**/*.ts.map",
      ".vscode/**",
      ".gitignore",
      ".eslint*",
      "CHANGELOG.md",
      "README.md",
      "LICENSE",
      "package-lock.json"
    ],
    "include": [
      "out/**",
      "node_modules/@sourcemeta/**",
      "node_modules/.bin/jsonschema"
    ]
  }
}
